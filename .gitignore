# ============================================================
#  Campus Companion AI — .gitignore
# ============================================================

# ── Node / npm ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ── Environment variables (NEVER commit secrets) ─────────────
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
backend/.env
frontend/.env

# ── Build output ─────────────────────────────────────────────
dist/
build/
frontend/dist/
frontend/build/

# ── Uploads (user-uploaded PDFs, etc.) ───────────────────────
backend/uploads/
!backend/uploads/.gitkeep

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
backend/logs/

# ── OS / Editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ── Vite / React cache ───────────────────────────────────────
frontend/.vite/
frontend/node_modules/

# ── MySQL dumps (keep schema + seeds; ignore raw dumps) ──────
*.sql.bak
database/dumps/

# ── Misc ─────────────────────────────────────────────────────
.cache/
.parcel-cache/
coverage/
.nyc_output/
